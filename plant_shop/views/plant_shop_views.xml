<odoo>
    <record id="plant_shop_action" model="ir.actions.act_window">
        <field name="name">Plants</field>
        <field name="res_model">plant_shop</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="plant_list" model="ir.ui.view">
        <field name="model">plant_shop</field>
        <field name="arch" type="xml">
            <list string="Plants">
                <field name="name"/>
                <field name="price"/>
                <field name="category_id"/>
                <field name="discount"/>
            </list>
        </field>
    </record>

    <record id="plant_form" model="ir.ui.view">
        <field name="model">plant_shop</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="price"/>
                    </group>
                    <group>
                        <field name="category_id"/>
                    </group>
                    <group>
                        <field name="discount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="search" model="ir.ui.view"> 
    <field name="model">plant_shop</field>
        <field name="arch" type="xml">
        <search string="Plants">
            <field name="name"/>
            <field name="price"/>
            <field name="category_id"/>
            <field name="discount"/>
        </search>
    </field>
    </record>

</odoo>
